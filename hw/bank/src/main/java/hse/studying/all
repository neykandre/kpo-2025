        BankAccount account = selectAccount();
        Menu menu = new Menu(
                "Update Account: " + account.getName(), Arrays.asList(
                new MenuItem("Update Name", () -> updateAccountName(account)),
                new MenuItem("Update Balance", () -> updateAccountBalance(account)),
